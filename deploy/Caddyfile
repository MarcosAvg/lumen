# Proxy de entrada de Lumen. `DOMAIN` es una dirección de sitio de Caddy:
# `http://localhost` (HTTP, puerto 80) o un dominio (HTTPS automático con Let's Encrypt).
# Avisos de expiración: añade `email tu@correo.example` al bloque global.
{
	admin off
}

{$DOMAIN:http://localhost} {
	encode zstd gzip
	reverse_proxy app:3000
}
