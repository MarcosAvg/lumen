# Lumen · configuración. Copia a `.env` (o ejecuta `./install.sh`).
# Las cuatro primeras son obligatorias; `install.sh` genera contraseña y VAPID.

# --- Obligatorias ---
# Evita `@ : / %`: se interpolan en la URL de PostgreSQL.
POSTGRES_PASSWORD=cambia-esta-clave
# Genera las claves con `./install.sh` o `pnpm vapid:generate`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Opcionales ---
# TZ=UTC
# LUMEN_TAG=latest

# --- Solo desarrollo local (los contenedores no las usan) ---
# DATABASE_URL=postgres://lumen:cambia-esta-clave@127.0.0.1:5432/lumen
# TEST_DATABASE_URL=postgres://lumen:cambia-esta-clave@127.0.0.1:5432/lumen_test
