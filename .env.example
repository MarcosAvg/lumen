# Lumen · variables de entorno de ejemplo. Copia a `.env` (o usa `./install.sh`).
# NUNCA incluyas secretos reales aquí.

# --- Docker Compose ---
# Credenciales de PostgreSQL (evita `@ : / %` en la contraseña: rompen la URL).
POSTGRES_USER=lumen
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=lumen

# Imagen y etiqueta (GHCR por defecto; `--build` compila en local).
LUMEN_IMAGE=ghcr.io/marcosavg/lumen
LUMEN_TAG=latest

# Puerto local donde se publica la app (127.0.0.1).
APP_PORT=8090

# --- Caddy opcional (`--profile caddy`) ---
# `DOMAIN`: `http://localhost` (HTTP) o un dominio (HTTPS automático).
# DOMAIN=lumen.midominio.com
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Aplicación ---
# Volumen de fotos (en Compose se sobreescribe a /data/photos).
PHOTO_STORAGE_PATH=./data/photos
# Tamaño máximo por archivo, en bytes (25 MiB).
MAX_UPLOAD_BYTES=26214400
# Cuerpo HTTP de adapter-node; debe superar MAX_UPLOAD_BYTES.
BODY_SIZE_LIMIT=30M
# Lado mayor de normalización (px) y de las miniaturas (px).
IMAGE_MAX_DIMENSION=2560
IMAGE_THUMB_DIMENSION=400
# Zona horaria de presentación (la persistencia es UTC).
TZ=UTC

# Origen público opcional: la imagen lo deriva de cada petición; solo se usa si
# compilas con `ORIGIN=... pnpm build`.
# ORIGIN=https://lumen.midominio.com

# --- Límites de recursos de los contenedores (opcionales) ---
# APP_MEM_LIMIT=1g
# APP_CPUS=2
# DB_MEM_LIMIT=1g
# DB_CPUS=2
# CADDY_MEM_LIMIT=256m
# CADDY_CPUS=1

# --- Límites de tasa (opcionales; en memoria, por instancia) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_UPLOAD_WINDOW_MS=60000

# --- Web Push con VAPID (opcional: sin claves, la bandeja interna sigue) ---
# Genera un par con `pnpm vapid:generate` o `./install.sh --vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Desarrollo en el host (Vite + PostgreSQL de compose.dev.yaml) ---
# Los contenedores no usan esto: dentro de Compose la URL apunta al host `db`.
DATABASE_URL=postgres://lumen:cambia-esta-clave@127.0.0.1:5432/lumen
TEST_DATABASE_URL=postgres://lumen:cambia-esta-clave@127.0.0.1:5432/lumen_test
