# Lumen · variables de entorno de ejemplo.
# Copia este archivo a `.env` y ajusta los valores. NUNCA incluyas secretos reales aquí.
# `./install.sh` genera un `.env` con contraseña aleatoria y arranca todo.

# --- Docker Compose (autoalojamiento) ---
# Credenciales de PostgreSQL. Tienen defaults en compose.yaml; en producción
# define una contraseña propia (sin caracteres que rompan la URL: evita @ : / %).
POSTGRES_USER=lumen
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=lumen

# Imagen de la aplicación. Por defecto se usa la publicada en GHCR; para compilar
# en local usa `docker compose -f compose.yaml -f compose.build.yaml up -d --build`.
LUMEN_IMAGE=ghcr.io/marcosavg/lumen
LUMEN_TAG=latest

# Puerto HTTP/HTTPS público donde escucha Caddy (por defecto 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443

# Dominio público. Es una *dirección de sitio* de Caddy:
#   - (sin definir o `http://localhost`) → sirve HTTP en HTTP_PORT.
#   - `lumen.midominio.com`              → HTTPS automático con Let's Encrypt.
# DOMAIN=lumen.midominio.com

# --- Aplicación ---
# Ruta del volumen persistente (fotos y miniaturas). No debe ser accesible por HTTP.
# En Compose se sobreescribe a /data/photos.
PHOTO_STORAGE_PATH=./data/photos
# Tamaño máximo por archivo, en bytes (25 MiB por defecto).
MAX_UPLOAD_BYTES=26214400
# Tamaño máximo del cuerpo HTTP aceptado por adapter-node (debe superar MAX_UPLOAD_BYTES).
BODY_SIZE_LIMIT=30M
# Lado mayor de normalización de fotografías (px).
IMAGE_MAX_DIMENSION=2560
# Lado mayor de las miniaturas generadas (px).
IMAGE_THUMB_DIMENSION=400
# Zona horaria de presentación (la persistencia siempre es UTC).
TZ=UTC

# Origen público **opcional**. La imagen deriva el origen de cada petición, así que
# no hace falta fijarlo ni reconstruir al cambiar de dominio. Solo se usa como
# origen de confianza si compilas con `ORIGIN=... pnpm build`.
# ORIGIN=https://lumen.midominio.com

# --- Límites de recursos de los contenedores (opcionales; valores por defecto) ---
# APP_MEM_LIMIT=1g
# APP_CPUS=2
# DB_MEM_LIMIT=1g
# DB_CPUS=2
# CADDY_MEM_LIMIT=256m
# CADDY_CPUS=1

# --- Límites de tasa (opcionales; valores por defecto entre paréntesis) ---
# Se aplican en memoria, por instancia. Ajusta solo si lo necesitas.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_UPLOAD_WINDOW_MS=60000

# --- Web Push con VAPID (opcional) ---
# Si se dejan vacías, la aplicación y la bandeja interna siguen operando.
# Genera un par con `pnpm vapid:generate` o `./install.sh --vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Desarrollo en el host (Vite + PostgreSQL de compose.dev.yaml) ---
# Los contenedores de producción NO usan esto: dentro de Compose la URL se
# construye contra el host `db`. Para `pnpm dev`/`pnpm db:migrate`, apunta a
# 127.0.0.1 (compose.dev.yaml publica ese puerto).
DATABASE_URL=postgres://lumen:cambia-esta-clave@127.0.0.1:5432/lumen
TEST_DATABASE_URL=postgres://lumen:cambia-esta-clave@127.0.0.1:5432/lumen_test
